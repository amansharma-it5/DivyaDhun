# Copy this file to keystore.properties locally; never commit the copy.
# The .gitignore already excludes keystore.properties and private key files.
# Use a dedicated Play upload key. Do not use the Android debug keystore.

storeFile=/absolute/path/to/divyadhun-upload-key.jks
storePassword=REPLACE_WITH_LOCAL_SECRET
keyAlias=divyadhun-upload
keyPassword=REPLACE_WITH_LOCAL_SECRET
